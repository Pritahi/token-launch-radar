{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.6-flash",
  "provider": {
    "google": {
      "options": { "apiKey": "{env:GOOGLE_GENERATIVE_AI_API_KEY}" }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "external_directory": "allow"
  }
}
